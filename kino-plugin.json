{
  "id": "sports-live-community",
  "name": "Deportes en vivo (M3U)",
  "version": "0.1.1",
  "apiVersion": 3,
  "entry": "plugin.js",
  "description": "Canales deportivos desde una lista M3U autorizada que configuras en Kino. La guía XMLTV es opcional. No incluye canales ni señales de terceros.",
  "author": "Ericktz",
  "hosts": [],
  "liveStreamHosts": "any",
  "capabilities": [
    "home",
    "resolve",
    "channels"
  ],
  "settings": [
    {
      "key": "m3uUrl",
      "label": "URL de la lista M3U autorizada",
      "type": "url",
      "required": true,
      "hint": "https://tu-proveedor.example/lista.m3u"
    },
    {
      "key": "epgUrl",
      "label": "URL de la guía XMLTV (opcional)",
      "type": "url",
      "hint": "https://tu-proveedor.example/guia.xml"
    }
  ],
  "homepage": "https://github.com/Ericktz/kino-plugin-sports-live",
  "categories": [
    "live"
  ]
}
